{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:ota": "npm run build && powershell Compress-Archive -Path dist/* -DestinationPath ota-releases/dist.zip -Force",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js ota-releases/dist.zip",
    "lint": "tsc --noEmit"
  },
